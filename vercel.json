{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "hnd1"
  ],
  "functions": {
    "api/identity.py": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/platform/:path*",
      "destination": "/api/identity"
    },
    {
      "source": "/queue",
      "destination": "https://task-queue-eight.vercel.app/queue"
    },
    {
      "source": "/queue/:path*",
      "destination": "https://task-queue-eight.vercel.app/queue/:path*"
    },
    {
      "source": "/api/queue/:path*",
      "destination": "https://task-queue-eight.vercel.app/api/queue/:path*"
    },
    {
      "source": "/linkedin",
      "destination": "https://linkedin-content-agent-mauve.vercel.app/linkedin"
    },
    {
      "source": "/linkedin/:path*",
      "destination": "https://linkedin-content-agent-mauve.vercel.app/linkedin/:path*"
    },
    {
      "source": "/api/linkedin/:path*",
      "destination": "https://linkedin-content-agent-mauve.vercel.app/api/linkedin/:path*"
    },
    {
      "source": "/showrun",
      "destination": "https://showrun-pi.vercel.app/showrun"
    },
    {
      "source": "/showrun/:path*",
      "destination": "https://showrun-pi.vercel.app/showrun/:path*"
    },
    {
      "source": "/api/showrun/:path*",
      "destination": "https://showrun-pi.vercel.app/api/showrun/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co https://*.googleusercontent.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/showrun(/.*)?",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co https://*.googleusercontent.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://vercel.com/api/blob/; media-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
